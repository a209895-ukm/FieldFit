{
  "name": "fieldfit",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc --noEmit && node scripts/build-server.mjs && vite build",
    "build:pages": "tsc --noEmit && vite build --mode pages",
    "prepare:pages": "npm run build:pages && node scripts/prepare-pages.mjs",
    "test:pages": "node --experimental-strip-types scripts/test-pages.mjs",
    "start": "node .server/server/index.js",
    "check": "tsc --noEmit",
    "test": "node --experimental-strip-types scripts/test-assessment.mjs",
    "test:api": "node scripts/test-api.mjs",
    "format": "prettier --write app server lib scripts index.html vite.config.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "^1.31.0",
    "radix-ui": "^1.6.7",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "recharts": "^3.8.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "3.6.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "tailwindcss": "4.2.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "vite": "8.0.13",
    "prettier": "3.6.2"
  },
  "type": "module"
}
